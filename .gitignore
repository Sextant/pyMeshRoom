# Private configuration and credentials. The example is the only config tracked.
/meshroom/meshroom.json
/meshroom/meshroom.*.json
!/meshroom/meshroom.json.example

# Runtime state can contain member data, shared secrets, or generated repeater keys.
/data/
/meshroom_data/
/test-data/
*.db
*.sqlite
*.sqlite3
*.log
*.pid

# Local Python environments and generated files.
.venv/
__pycache__/
*.py[cod]

# Keep locally supplied credentials and keys out of commits.
.env
.env.*
*.pem
*.key

# The WhereBot config holds its private key and API key.
/bots/where_bot/where_bot.yaml
__pycache__/

# Antenna test results.
/tools/antenna_test/results/

# MeshCore Web (web/)
web/node_modules/
