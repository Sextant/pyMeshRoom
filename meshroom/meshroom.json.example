{
  "_about": "meshroom settings. Sections are only for readability: any setting may also sit at the top level. Keys starting with _ are notes.",

  "room": {
    "name": "PiRoom",
    "lat": 0.00,
    "lon": 0.00,
    "identity": "modem",
    "advert_interval_min": 60,
    "flood_advert_interval_h": 12
  },

  "access": {
    "_note": "room_password \"\" = open room: anyone can join with a blank password. admin_password \"\" disables RF admin access. Set non-empty admin and web passwords before enabling their admin functions.",
    "admin_password": "",
    "room_password": "",
    "allow_read_only": false
  },

  "radio": {
    "serial": "/dev/ttyACM0",
    "baud": 115200,
    "radio_freq_mhz": 910.525,
    "radio_bw_khz": 62.5,
    "radio_sf": 7,
    "radio_cr": 5,
    "radio_tx_power_dbm": null,
    "path_hash_mode": 1
  },

  "modem_csma": {
    "_note": "KISS channel access: txdelay and slottime in 10 ms units, persistence 0-255 (128 = 50% chance per slot).",
    "kiss_txdelay": 1,
    "kiss_persistence": 128,
    "kiss_slottime": 5
  },

  "posts": {
    "max_posts": 10,
    "catchup_max": 3,
    "dedupe_window_s": 300
  },

  "delivery": {
    "_note": "Gaps are waits between pushes: base + per hop (direct routes), or the flood value.",
    "push_pace_start_ms": 2000,
    "push_pace_min_ms": 1500,
    "push_pace_max_ms": 8000,
    "push_gap_flood_ms": 10000,
    "push_quiet_ms": 1500,
    "extra_acks": 1
  },

  "routing": {
    "route_halflife_h": 6,
    "topology_halflife_h": 24,
    "routes_per_member": 6
  },

  "neighbours": {
    "discovery_interval_min": 10,
    "trace_neighbours": true,
    "trace_min_interval_s": 60
  },

  "messages": {
    "_note": "{room} is replaced with the room name.",
    "welcome_new_members": true,
    "welcome_message": "DM from room: You have successfully logged in!",
    "welcome_advert_hint": "DM from room: Your name is unknown, please send a flood advert.",
    "kick_message": "DM from room: You have been kicked and will need to log in again.",
    "ban_message": "DM from room: You have been banned and your client will now be ignored."
  },

  "mqtt": {
    "_note": "MQTT augmentation: also listen to the observer network. RF is always used for fallback and route calculations. Switches can be flipped on the dashboard (admin) and are saved here.",
    "mqtt_enabled": false,
    "mqtt_ack_ingest": true,
    "mqtt_msg_ingest": true,
    "mqtt_topo_ingest": true,
    "mqtt_advert_ingest": true,
    "mqtt_activity": true,
    "mqtt_channels": [
      "Public"
    ],
    "mqtt_host": "mqtt.gomesh.dev",
    "mqtt_port": 443,
    "mqtt_transport": "websockets",
    "mqtt_ws_path": "/mqtt",
    "mqtt_tls": true,
    "mqtt_tls_verify": true,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_queue_max": 1000,
    "mqtt_topics": [
      "meshcore/#"
    ]
  },

  "repeater": {
    "_note": "Virtual repeater: a second identity on the room's radio, relaying like MeshCore's simple_repeater. repeater_key \"\" = a new identity is generated and saved here on first start (a 32-byte seed, or paste a 64-byte MeshCore private key; never reuse a key a hardware repeater is still using). Unscoped floods are always relayed; scope mode/regions apply to region-scoped floods ('allow' with no regions = relay no scoped floods, as firmware does by default). repeater_relay false = kill switch: still advertises, relays nothing. All of this can be changed from the dashboard (admin).",
    "repeater_enabled": false,
    "repeater_relay": false,
    "repeater_name": "pyMeshRoom Virtual Repeater",
    "repeater_key": "",
    "repeater_advert_interval_min": 60,
    "repeater_flood_advert_interval_h": 12,
    "repeater_scope_mode": "allow",
    "repeater_regions": [],
    "repeater_airtime_pct": 50,
    "repeater_loop_detect": "minimal"
  },

  "tenants": {
    "_note": "Tenant rooms: more rooms on this radio, created and deleted from the dashboard (admin). Each entry is only {name, path, public_key}; the room's key, passwords, members and posts are in data_dir/tenants/<public key>.db.",
    "tenant_rooms": []
  },

  "companion": {
    "_note": "Virtual companion: a chat node on the room's radio that MeshCore apps connect to over TCP, like a WiFi companion radio. Its port is open only while companion_enabled is true. The companion protocol has no password: never forward the port from the internet; companion_allow lists the addresses/networks allowed to connect (empty = anyone who can reach it). companion_key \"\" = a new identity is generated and saved here on first start. Radio settings, Bluetooth PIN, reboot and factory reset sent by the app are acknowledged and ignored. Its contacts and messages are kept in companion.db in data_dir. All of this can be changed from the dashboard (admin).",
    "companion_enabled": false,
    "companion_name": "pyMeshRoom Companion",
    "companion_key": "",
    "companion_port": 5000,
    "companion_bind": "0.0.0.0",
    "companion_allow": [],
    "companion_auto_advert": false,
    "companion_advert_interval_min": 60,
    "companion_advert_flood": false
  },

  "dashboard": {
    "web_port": 8081,
    "web_bind": "0.0.0.0",
    "web_password": ""
  },

  "observer": {
    "_note": "Optional MQTT packet observer. Bundled paho-mqtt is used when no installed copy is available; it never opens the serial device. Packets and RX are compatibility gates for the same RX-only packet reporting path.",
    "observer_enabled": false,
    "observer_iata": "SJC",
    "observer_status": true,
    "observer_packets": true,
    "observer_rx": true,
    "observer_gomesh": true,
    "observer_meshmapper": true,
    "observer_servers": null,
    "observer_queue_max": 1000
  },

  "system": {
    "data_dir": "/opt/meshroom/data",
    "log_level": "INFO"
  }
}
